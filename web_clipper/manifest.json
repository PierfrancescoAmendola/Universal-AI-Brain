{
  "manifest_version": 3,
  "name": "Universal AI Brain - Web Clipper",
  "version": "1.0.0",
  "description": "Salva e classifica istantaneamente articoli, documentazioni e ricerche nel tuo connettoma cognitivo (Safari & Chromium).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Salva nel Cervello"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://universal-ai-brain.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}
